# ==============================================================================
# Sports API Backend Configuration
# ==============================================================================

# API Configuration
PROJECT_NAME="Sports IPTV API"
API_V1_STR="/api/v1"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database (Default: local SQLite database, easily swapped with PostgreSQL)
# Example PostgreSQL: postgresql+aiosqlite:///sports.db or postgresql+asyncpg://user:pass@localhost:5432/sports
DATABASE_URL="sqlite+aiosqlite:///./sports.db"

# Free Sports Data Provider API Keys
# TheSportsDB free public tier uses key "3" by default, or your custom key
THESPORTSDB_API_KEY="3"
THESPORTSDB_ENABLED=true

# API-Football (RapidAPI or direct API-Sports free tier)
# https://dashboard.api-football.com/
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
API_FOOTBALL_ENABLED=true

# API-Basketball (API-Sports free tier)
# https://dashboard.api-football.com/basketball
API_BASKETBALL_KEY=""
API_BASKETBALL_BASE_URL="https://v1.basketball.api-sports.io"
API_BASKETBALL_ENABLED=true

# Cricket API (e.g., CricAPI / CricketData / TheSportsDB)
CRICKET_API_KEY=""
CRICKET_ENABLED=true

# Tennis API (e.g., TheSportsDB / Free Tennis APIs)
TENNIS_API_KEY=""
TENNIS_ENABLED=true

# Cache Configuration & TTLs (in seconds)
CACHE_ENABLED=true
CACHE_TTL_LIVE=60           # 1 minute
CACHE_TTL_STARTING_SOON=180 # 3 minutes
CACHE_TTL_TODAY=600         # 10 minutes
CACHE_TTL_UPCOMING=1800     # 30 minutes
CACHE_TTL_BROADCASTERS=14400 # 4 hours
CACHE_TTL_FINISHED=86400    # 24 hours

# Channel Matching Settings
CHANNEL_MATCH_THRESHOLD=0.80

# Background Cache Refresh Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_REFRESH_INTERVAL_MINUTES=5
